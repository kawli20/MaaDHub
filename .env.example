# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (used for JWT signing)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# ── Telegram (Server / Cloudflare Worker secrets) ──────────────
TELEGRAM_BOT_TOKEN=       # Telegram Bot Token from @BotFather (keep secret, server-only)
TELEGRAM_CHANNEL_ID=      # Telegram channel ID (e.g. -1004445400084)
